# Copy to .env (loaded automatically via python-dotenv - see config/settings.py)
# or export these in your shell before running the pipeline. Only an LLM key
# (matching LLM_PROVIDER) and the Google Sheets credentials are required for a
# full run; everything else has a sensible default (see config/settings.py).

# --- required ---

# Which LLM backend the classification confirmation pass uses: "anthropic"
# (default) or "gemini". Set the matching API key below.
LLM_PROVIDER=anthropic

# Claude API key, used when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini API key, used when LLM_PROVIDER=gemini.
# Get one at https://aistudio.google.com/apikey
# Note: free-tier quotas vary sharply by model on a per-project basis and
# were verified live (2026-07-26): "pro" models returned 429 with quota
# limit 0 (billing not enabled); "gemini-flash-latest" (-> gemini-3.6-flash)
# free tier is only 20 requests/DAY per project (exhausted quickly during a
# real run). The default (gemini-flash-lite-latest) has its own separate
# quota bucket and was confirmed working end-to-end. Enable billing on the
# GCP project to raise limits and use a stronger model.
GEMINI_API_KEY=

# Path to a Google service-account credentials JSON file, used by the
# Google Sheets storage backend. Create one in Google Cloud Console
# (IAM & Admin > Service Accounts), enable the Sheets API on the project,
# and share your target spreadsheet with the service account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The target Google Sheet's id (the long id in its URL between /d/ and /edit).
PIPELINE_GOOGLE_SHEET_ID=

# --- optional overrides ---

# Contact email sent as a "polite pool" identifier to OpenAlex/Crossref/arXiv
# (gets you faster, more reliable service; not required to function).
PIPELINE_CONTACT_EMAIL=you@example.com

# Semantic Scholar's unauthenticated tier is shared and heavily rate-limited.
# A free key (https://www.semanticscholar.org/product/api#api-key) raises
# your personal limit substantially.
SEMANTIC_SCHOLAR_API_KEY=

# CORE API key — only needed if you add the optional CORE discovery source
# (not wired into the default 4 sources; see README).
CORE_API_KEY=

# Results requested per query per source (default 15).
PIPELINE_RESULTS_PER_QUERY=15

# Fuzzy title-match threshold, 0-100 (default 92).
PIPELINE_FUZZY_TITLE_THRESHOLD=92

# Local sentence-transformers model name (default all-MiniLM-L6-v2).
PIPELINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding cosine-similarity shortlist threshold, 0-1 (default 0.30).
PIPELINE_EMBED_THRESHOLD=0.30

# Max domain/subdomain targets shortlisted per paper (default 8).
PIPELINE_EMBED_TOP_K=8

# Model used for the confirmation pass. Default depends on LLM_PROVIDER:
# claude-sonnet-5 (anthropic) or gemini-flash-lite-latest (gemini). Leave
# commented out to use the provider default; uncomment to override.
# PIPELINE_LLM_MODEL=

# Confidence below which a classified record is routed to needs_review (default 0.55).
PIPELINE_REVIEW_THRESHOLD=0.55
