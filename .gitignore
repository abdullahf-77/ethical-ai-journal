# ---- Secrets — never commit these ----
.env
.env.*
!.env.example
*service-account*.json
*service_account*.json
*credentials*.json
*.pem
*.key

# ---- Node / frontend ----
node_modules/
dist/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ---- Python / pipeline ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- Pipeline generated data (regenerated by running the pipeline) ----
pipeline/data/raw/*
pipeline/data/processed/*
pipeline/data/classified/*
pipeline/data/excluded/*
pipeline/data/exports/*
!pipeline/data/**/.gitkeep

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
